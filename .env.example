# Copy this file to .env and fill in your keys.
# Get free-tier keys at:
#   Anthropic  https://console.anthropic.com
#   Finnhub    https://finnhub.io
#   Voyage AI  https://dash.voyageai.com

ANTHROPIC_API_KEY=your-anthropic-key-here
FINNHUB_KEY=your-finnhub-key-here
VOYAGE_API_KEY=your-voyage-key-here

# Optional: identifies you to the SEC (they require a contact email).
# Defaults to the value in src/config.py if unset.
# SEC_USER_AGENT=YourApp your.email@example.com